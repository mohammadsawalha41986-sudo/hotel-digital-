{
  "name": "hotel-digital-guest-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "npm run typecheck",
    "test": "node --import tsx --test --test-concurrency=1 tests/api/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file-if-exists=.env server/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env server/cli.ts seed",
    "db:seed:demo": "tsx --env-file-if-exists=.env server/cli.ts seed-demo",
    "admin:create": "tsx --env-file-if-exists=.env server/cli.ts create-admin",
    "import:firestore": "tsx --env-file-if-exists=.env server/cli.ts import-firestore"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-query": "^5.103.2",
    "exceljs": "^4.4.0",
    "hono": "^4.13.9",
    "lucide-react": "^1.16.0",
    "motion": "^13.4.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": ">=22.9"
  }
}
