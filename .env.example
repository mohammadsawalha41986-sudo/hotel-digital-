# --- Required ---------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgres://hub:hub@localhost:5432/hotelhub

# --- Server -----------------------------------------------------------------
PORT=8080
# Public URL of the site (used for the CSRF origin check behind proxies), e.g. https://guest.example.com
PUBLIC_ORIGIN=
# 1 when running behind a TLS-terminating proxy (default in production)
TRUST_PROXY=
# Directory for uploaded media. Use a persistent volume in production.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
SESSION_DAYS=7
# Set to 1 when the database requires TLS (e.g. managed PostgreSQL)
DATABASE_SSL=
DB_POOL_MAX=10
# Slug served at "/" (defaults to the first published hotel)
DEFAULT_HOTEL_SLUG=swiss-flora-royal
LOG_LEVEL=info

# --- Tests ------------------------------------------------------------------
DATABASE_URL_TEST=postgres://hub:hub@localhost:5432/hotelhub_test
DATABASE_URL_E2E=postgres://hub:hub@localhost:5432/hotelhub_e2e
