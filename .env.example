# --- Required ---------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgres://hub:hub@localhost:5432/hotelhub

# --- Server -----------------------------------------------------------------
PORT=8080
# Public URL of the site (used for the CSRF origin check behind proxies), e.g. https://guest.example.com
PUBLIC_ORIGIN=
# 1 when running behind a TLS-terminating proxy (default in production)
TRUST_PROXY=
# Directory for uploaded media. Use a persistent volume in production.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
SESSION_DAYS=7
# Set to 1 when the database requires TLS (e.g. managed PostgreSQL)
DATABASE_SSL=
DB_POOL_MAX=10
# Slug served at "/" (defaults to the first published hotel)
DEFAULT_HOTEL_SLUG=swiss-flora-royal
LOG_LEVEL=info
# 1 runs the daily guest-data retention job (only hotels with a retention period are affected).
# Leave unset in production until backups are verified.
RETENTION_JOB=
# 1 disables background jobs on this instance (debugging)
JOBS_DISABLED=
# Migrations run in the release step (npm run release); instances skip them when 1
SKIP_MIGRATIONS=
# Worker processes per container (≈ vCPUs) and drain time after SIGTERM
WEB_CONCURRENCY=1
SHUTDOWN_GRACE_MS=5000
# Database timeouts (ms)
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# --- Media storage ----------------------------------------------------------
# local (default, single instance) or s3 (required with more than one replica).
# With a Railway Bucket, reference its BUCKET / ENDPOINT / ACCESS_KEY_ID /
# SECRET_ACCESS_KEY / REGION variables (S3_* names are accepted too).
STORAGE_DRIVER=
BUCKET=
ENDPOINT=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
# 1 for older buckets that need path-style URLs
S3_PATH_STYLE=
# Per-replica caches
BUNDLE_CACHE_MS=10000
HOTEL_ROW_CACHE_MS=5000
MEDIA_CACHE_MB=64

# --- Staging only (never in production) -------------------------------------
# ALLOW_SYNTHETIC_DATA=1
# RELEASE_SEED_DEMO=1
# RELEASE_SYNTH_HOTELS=20

# --- Tests ------------------------------------------------------------------
DATABASE_URL_TEST=postgres://hub:hub@localhost:5432/hotelhub_test
DATABASE_URL_E2E=postgres://hub:hub@localhost:5432/hotelhub_e2e
